# ==========================================
# Root .gitignore for ShadowBase
# ==========================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Specific Files
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# Java & Maven Artifacts (Backend)
shadowbase/target/
shadowbase/*.log
shadowbase/.flattened-pom.xml

# Node.js & React Artifacts (Frontend)
shadowbase-frontend/node_modules/
shadowbase-frontend/dist/
shadowbase-frontend/dist-ssr/
shadowbase-frontend/*.local
shadowbase-frontend/.eslintcache

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment Variables
.env
.env.local
.env.*.local

# Archives
*.zip
*.tar.gz

